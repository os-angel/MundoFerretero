---
// Categories.astro
import type { ImageMetadata } from 'astro';

interface Props {
  t: Record<string, any>;
  lang: string;
  categories: any[];
}
const { t, lang, categories } = Astro.props;
---

<section class="categories section" id="productos" aria-labelledby="categories-title">
  <div class="container">

    <!-- Section Header -->
    <div class="categories-header">
      <h2 class="section-title" id="categories-title">{t.categories.title}</h2>
      <p class="section-subtitle">{t.categories.subtitle}</p>
    </div>

    <!-- Grid -->
    <div class="categories-grid" role="list">
      {categories.map((cat) => {
        const name = cat.name[lang] ?? cat.name.es;
        const description = cat.description[lang] ?? cat.description.es;
        const imageAlt = cat.imageAlt[lang] ?? cat.imageAlt.es;

        return (
          <article class="category-item" role="listitem">
            <div class="category-img-wrap">
              <img
                src={cat.image}
                alt={imageAlt}
                class="category-img"
                width="480"
                height="360"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="category-body">
              <h3 class="category-name">{name}</h3>
              <p class="category-desc">{description}</p>
            </div>
          </article>
        );
      })}
    </div>

  </div>
</section>

<style>
  .categories { background-color: var(--c-bg); }
  .categories-header { margin-bottom: var(--sp-6); max-width: 620px; }
  .categories-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--sp-3); }
  .category-item { display: flex; flex-direction: column; min-width: 0; overflow: hidden; background: var(--c-white); border: 1px solid var(--c-border); border-radius: var(--radius-md); transition: border-color var(--t-fast), box-shadow var(--t-fast); }
  .category-item:hover { border-color: #b7c0ca; box-shadow: 0 2px 8px rgba(20, 34, 56, .08); }
  .category-img-wrap { aspect-ratio: 4 / 3; background: var(--c-white); border-bottom: 1px solid var(--c-border); }
  .category-img { width: 100%; height: 100%; padding: var(--sp-3); object-fit: contain; }
  .category-body { display: flex; flex: 1; flex-direction: column; align-items: flex-start; padding: var(--sp-4); }
  .category-name { color: var(--c-blue); font-size: var(--text-base); font-weight: 700; line-height: 1.25; }
  .category-desc { display: none; margin-top: var(--sp-2); color: var(--c-text-muted); font-size: var(--text-sm); line-height: 1.45; }
  @media (min-width: 640px) { .categories-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--sp-4); } .category-desc { display: block; } }
  @media (min-width: 1024px) { .categories-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } .category-body { padding: var(--sp-5); } }
</style>
