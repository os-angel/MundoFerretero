---
// Categories.astro
import type { ImageMetadata } from 'astro';

interface Props {
  t: Record<string, any>;
  lang: string;
  categories: any[];
}
const { t, lang, categories } = Astro.props;
const waMsg = encodeURIComponent(t.common.whatsapp_msg);
const waUrl = `https://wa.me/${t.common.wa_number}?text=${waMsg}`;
---

<section class="categories section" id="productos" aria-labelledby="categories-title">
  <div class="container">

    <!-- Section Header -->
    <div class="categories-header">
      <h2 class="section-title" id="categories-title">{t.categories.title}</h2>
      <p class="section-subtitle">{t.categories.subtitle}</p>
    </div>

    <!-- Grid -->
    <div class="categories-grid" role="list">
      {categories.map((cat) => {
        const name = cat.name[lang] ?? cat.name.es;
        const description = cat.description[lang] ?? cat.description.es;
        const imageAlt = cat.imageAlt[lang] ?? cat.imageAlt.es;
        const catWaMsg = encodeURIComponent(`Hola Mundo Ferretero, quisiera consultar precios de: ${cat.name.es}`);
        const catWaUrl = `https://wa.me/${t.common.wa_number}?text=${catWaMsg}`;

        return (
          <article class="category-item" role="listitem">
            <div class="category-img-wrap">
              <img
                src={cat.image}
                alt={imageAlt}
                class="category-img"
                width="480"
                height="360"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="category-body">
              <h3 class="category-name">{name}</h3>
              <p class="category-desc">{description}</p>
              <a
                href={catWaUrl}
                class="category-cta"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Consultar precio de ${name} por WhatsApp`}
              >
                {t.categories.cta}
                <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </a>
            </div>
          </article>
        );
      })}
    </div>

  </div>
</section>

<style>
  .categories { background-color: var(--c-white); }

  .categories-header { margin-bottom: var(--sp-8); max-width: 620px; }

  .categories-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--sp-3);
  }

  @media (min-width: 430px) {
    .categories-grid {
      gap: var(--sp-5);
    }
  }

  @media (min-width: 1024px) {
    .categories-grid {
      grid-template-columns: repeat(12, 1fr);
      grid-template-rows: repeat(2, 230px);
      gap: var(--sp-5);
    }
    .category-item:nth-child(1), .category-item:nth-child(4) { grid-column: span 5; }
    .category-item:nth-child(2), .category-item:nth-child(3), .category-item:nth-child(5), .category-item:nth-child(6) { grid-column: span 7; }
  }

  .category-item {
    position: relative;
    min-height: 210px;
    background-color: var(--c-blue);
    border: 0;
    border-radius: 18px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    isolation: isolate;
    transition: transform var(--t-base), box-shadow var(--t-base);
  }

  .category-item:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 28px rgba(20, 34, 56, .18);
  }

  .category-img-wrap {
    overflow: hidden;
    position: absolute;
    inset: 0;
    aspect-ratio: auto;
  }

  .category-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: .72;
    transition: transform var(--t-slow);
  }

  .category-item:hover .category-img {
    transform: scale(1.03);
  }

  .category-body {
    position: relative;
    z-index: 1;
    padding: var(--sp-5);
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    background: linear-gradient(transparent, rgba(12, 24, 40, .92));
  }

  .category-name {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--c-white);
    line-height: 1.2;
  }

  .category-desc {
    font-size: var(--text-sm);
    display: none;
    color: rgba(255,255,255,.78);
    line-height: 1.55;
    flex: 1;
  }

  .category-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    font-size: var(--text-sm);
    font-weight: 700;
    color: #ffd3ae;
    margin-top: var(--sp-1);
    transition: gap var(--t-fast), color var(--t-fast);
  }

  @media (min-width: 640px) { .category-desc { display: block; } }

  .category-cta:hover,
  .category-cta:focus-visible {
    color: var(--c-orange-dark);
    gap: var(--sp-3);
  }
</style>
