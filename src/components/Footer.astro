---
// Footer.astro
interface Props {
  t: Record<string, any>;
}
const { t } = Astro.props;
const phoneUrl = `tel:${t.common.phone_number.replace(/[\s\-]/g, '')}`;
const waMsg = encodeURIComponent(t.common.whatsapp_msg);
const waUrl = `https://wa.me/${t.common.wa_number}?text=${waMsg}`;
const year = new Date().getFullYear();
---

<footer class="site-footer" role="contentinfo">
  <div class="container footer-inner">

    <!-- Brand column -->
    <div class="footer-brand">
      <a href="/" class="footer-logo-link" aria-label="Mundo Ferretero — Inicio">
        <img
          src="/logo.png"
          alt="Mundo Ferretero"
          class="footer-logo"
          width="140"
          height="56"
          loading="lazy"
          decoding="async"
        />
      </a>
      <p class="footer-tagline">Materiales para construcción en Santiago Atitlán.</p>
      <p class="footer-location">{t.footer.location_short}</p>
    </div>

    <!-- Products column -->
    <div class="footer-col">
      <h3 class="footer-col-title">{t.footer.products_col}</h3>
      <ul class="footer-links">
        <li><a href="#productos" class="footer-link">Cemento</a></li>
        <li><a href="#productos" class="footer-link">Block</a></li>
        <li><a href="#productos" class="footer-link">Tubería y drenaje</a></li>
        <li><a href="#productos" class="footer-link">Tubo ducto PVC</a></li>
        <li><a href="#productos" class="footer-link">Sanitarios</a></li>
        <li><a href="#productos" class="footer-link">Hierro y acero</a></li>
      </ul>
    </div>

    <!-- Services column -->
    <div class="footer-col">
      <h3 class="footer-col-title">{t.footer.services_col}</h3>
      <ul class="footer-links">
        {t.footer.services_list.map((s: string) => (
          <li><span class="footer-text">{s}</span></li>
        ))}
      </ul>
    </div>

    <!-- Contact column -->
    <div class="footer-col">
      <h3 class="footer-col-title">{t.footer.contact_col}</h3>
      <ul class="footer-links">
        <li>
          <a href={phoneUrl} class="footer-link" aria-label={`Llamar al ${t.common.phone_number}`}>
            {t.common.phone_number}
          </a>
        </li>
        <li>
          <a href={waUrl} class="footer-link" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp Mundo Ferretero">
            WhatsApp
          </a>
        </li>
        <li>
          <a href="https://www.mundoferreterogt.com" class="footer-link">
            mundoferreterogt.com
          </a>
        </li>
        <li>
          <a href="#envio" class="footer-link">Servicio de envío</a>
        </li>
      </ul>
    </div>

  </div>

  <!-- Bottom bar -->
  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p class="footer-copy">{t.footer.copyright} · {year}</p>
      <p class="footer-domain">
        <a href="https://www.mundoferreterogt.com" class="footer-link--domain">www.mundoferreterogt.com</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--c-blue);
    color: rgba(255, 255, 255, 0.75);
    padding-top: var(--sp-16);
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-10);
  }

  @media (min-width: 640px) {
    .footer-inner {
      grid-template-columns: repeat(2, 1fr);
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1024px) {
    .footer-inner {
      grid-template-columns: 2fr 1fr 1fr 1fr;
      gap: var(--sp-12);
    }
    .footer-brand {
      grid-column: auto;
    }
  }

  /* Brand */
  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  .footer-logo-link {
    display: inline-block;
    width: fit-content;
  }

  .footer-logo {
    height: 64px;
    width: auto;
    max-width: 260px;
    object-fit: contain;
    border-radius: var(--radius-sm);
    filter: brightness(1);
  }

  .footer-tagline {
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.65);
    max-width: 28ch;
    line-height: 1.5;
  }

  .footer-location {
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.45);
  }

  /* Columns */
  .footer-col-title {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.45);
    margin-bottom: var(--sp-4);
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  .footer-link {
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.72);
    transition: color var(--t-fast);
  }

  .footer-link:hover,
  .footer-link:focus-visible {
    color: var(--c-white);
  }

  .footer-text {
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.72);
  }

  /* Bottom bar */
  .footer-bottom {
    margin-top: var(--sp-12);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-block: var(--sp-5);
  }

  .footer-bottom-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--sp-3);
  }

  .footer-copy {
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.4);
  }

  .footer-link--domain {
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.4);
    transition: color var(--t-fast);
  }

  .footer-link--domain:hover {
    color: rgba(255, 255, 255, 0.7);
  }
</style>
