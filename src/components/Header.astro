---
// Header.astro
interface Props {
  t: Record<string, any>;
  lang: string;
}
const { t, lang } = Astro.props;
const waMsg = encodeURIComponent(t.common.whatsapp_msg);
const waUrl = `https://wa.me/${t.common.wa_number}?text=${waMsg}`;
const homeUrl = lang === 'es' ? '/' : `/${lang}`;
const langUrls = { es: '/', en: '/en' };
---

<header class="site-header" id="site-header" role="banner">
  <div class="service-bar">
    <div class="container service-bar-inner">
      <span>Envíos en Santiago Atitlán y alrededores</span>
      <a href="tel:+50239216866">¿Necesitas ayuda? Llámanos: +502 3921-6866</a>
    </div>
  </div>
  <div class="container header-inner">

    <!-- Logo -->
    <a href={homeUrl} class="header-logo" aria-label="Mundo Ferretero — Inicio">
      <img
        src="/logo.png"
        alt="Mundo Ferretero — Ferretería en Santiago Atitlán"
        class="logo-img"
        width="160"
        height="64"
        fetchpriority="high"
      />
    </a>

    <!-- Desktop Nav -->
    <nav class="header-nav" aria-label="Navegación principal">
      <a href={homeUrl} class="nav-link" aria-current="page">{t.nav.home}</a>
      <a href="#productos" class="nav-link">{t.nav.products}</a>
      <a href="#envio" class="nav-link">{t.nav.services}</a>
      <a href="#contacto" class="nav-link">{t.nav.contact}</a>
    </nav>

    <!-- Header actions -->
    <div class="header-actions">
      <!-- Language switcher -->
      <div class="lang-switcher" role="group" aria-label="Seleccionar idioma">
        <a class={`lang-btn ${lang === 'es' ? 'lang-btn--active' : ''}`} href={langUrls.es} aria-current={lang === 'es' ? 'page' : undefined}>ES</a>
        <a class={`lang-btn ${lang === 'en' ? 'lang-btn--active' : ''}`} href={langUrls.en} aria-current={lang === 'en' ? 'page' : undefined}>EN</a>
      </div>

      <!-- WhatsApp button -->
      <a
        href={waUrl}
        class="btn btn--primary header-wa-btn"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Contactar por WhatsApp"
        id="header-whatsapp-btn"
      >
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.890-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        {t.nav.whatsapp}
      </a>

      <!-- Mobile menu toggle -->
      <button
        class="menu-toggle"
        id="menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Abrir menú"
      >
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div class="mobile-menu" id="mobile-menu" role="dialog" aria-label="Menú de navegación" aria-hidden="true">
    <nav aria-label="Menú móvil">
      <a href={homeUrl} class="mobile-nav-link">{t.nav.home}</a>
      <a href="#productos" class="mobile-nav-link">{t.nav.products}</a>
      <a href="#envio" class="mobile-nav-link">{t.nav.services}</a>
      <a href="#contacto" class="mobile-nav-link">{t.nav.contact}</a>
    </nav>
    <div class="mobile-lang">
      <a class={`lang-btn ${lang === 'es' ? 'lang-btn--active' : ''}`} href={langUrls.es} aria-current={lang === 'es' ? 'page' : undefined}>ES</a>
      <a class={`lang-btn ${lang === 'en' ? 'lang-btn--active' : ''}`} href={langUrls.en} aria-current={lang === 'en' ? 'page' : undefined}>EN</a>
    </div>
    <a
      href={waUrl}
      class="btn btn--primary mobile-wa-btn"
      target="_blank"
      rel="noopener noreferrer"
    >
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.890-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
      {t.nav.whatsapp}
    </a>
  </div>
</header>

<script>
  // Mobile menu toggle
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!isOpen));
    toggle.setAttribute('aria-label', isOpen ? 'Abrir menú' : 'Cerrar menú');
    menu?.setAttribute('aria-hidden', String(isOpen));
    toggle.classList.toggle('is-open', !isOpen);
    menu?.classList.toggle('is-open', !isOpen);
  });

  // Close menu on mobile link click
  menu?.querySelectorAll('.mobile-nav-link').forEach(link => {
    link.addEventListener('click', () => {
      toggle?.setAttribute('aria-expanded', 'false');
      toggle?.setAttribute('aria-label', 'Abrir menú');
      menu.setAttribute('aria-hidden', 'true');
      toggle?.classList.remove('is-open');
      menu.classList.remove('is-open');
    });
  });

</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--c-white);
    border-bottom: 1px solid var(--c-border);
    height: auto;
    box-shadow: 0 1px 4px rgba(20, 34, 56, .08);
  }

  .service-bar { background: var(--c-blue); color: rgba(255,255,255,.82); font-size: .72rem; font-weight: 700; }
  .service-bar-inner { height: 26px; display: flex; justify-content: space-between; align-items: center; gap: var(--sp-4); }
  .service-bar a { color: var(--c-white); }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-6);
    padding-block: .35rem;
    min-height: 70px;
  }

  /* Logo */
  .header-logo {
    position: relative;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    width: 210px;
    height: 58px;
    overflow: hidden;
  }

  .logo-img {
    position: absolute;
    left: 50%;
    top: 67%;
    width: 318px;
    max-width: none;
    height: auto;
    transform: translate(-50%, -50%);
    transition: transform var(--t-fast);
  }

  .header-logo:hover .logo-img {
    transform: translate(-50%, -50%) scale(1.02);
  }

  @media (min-width: 1024px) {
    .logo-img {
      width: 380px;
    }
    .header-logo {
      width: 250px;
      height: 68px;
    }
  }

  /* Desktop nav */
  .header-nav {
    display: none;
    gap: var(--sp-6);
    align-items: center;
  }

  .nav-link {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--c-text);
    transition: color var(--t-fast);
    padding-block: var(--sp-2);
    border-bottom: 2px solid transparent;
  }

  .nav-link:hover,
  .nav-link:focus-visible,
  .nav-link[aria-current="page"] {
    color: var(--c-blue);
    border-bottom-color: var(--c-orange);
  }

  /* Actions */
  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    margin-left: auto;
  }

  /* Language switcher */
  .lang-switcher {
    display: none;
    gap: var(--sp-1);
    align-items: center;
  }

  .lang-btn {
    background: none;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-sm);
    color: var(--c-text-muted);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.45rem;
    cursor: pointer;
    transition: border-color var(--t-fast), color var(--t-fast), background-color var(--t-fast);
  }

  .lang-btn:hover,
  .lang-btn:focus-visible {
    border-color: var(--c-blue);
    color: var(--c-blue);
  }

  .lang-btn--active {
    background-color: var(--c-orange);
    border-color: var(--c-orange);
    color: var(--c-white);
  }

  /* WhatsApp header btn */
  .header-wa-btn {
    display: none;
    font-size: var(--text-xs);
    padding: 0.5rem 1rem;
  }

  /* Hamburger */
  .menu-toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    padding: var(--sp-2);
    background: none;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: border-color var(--t-fast);
    flex-shrink: 0;
  }

  .menu-toggle:hover,
  .menu-toggle:focus-visible {
    border-color: var(--c-blue);
  }

  .hamburger-line {
    display: block;
    width: 100%;
    height: 2px;
    background-color: var(--c-blue);
    border-radius: 2px;
    transition: transform var(--t-base), opacity var(--t-fast);
    transform-origin: center;
  }

  .menu-toggle.is-open .hamburger-line:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .menu-toggle.is-open .hamburger-line:nth-child(2) {
    opacity: 0;
  }
  .menu-toggle.is-open .hamburger-line:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Mobile menu */
  .mobile-menu {
    display: none;
    position: absolute;
    top: 96px;
    left: 0;
    right: 0;
    background-color: var(--c-blue-dark);
    border-top: 1px solid rgba(255,255,255,0.08);
    padding: var(--sp-4) var(--gutter) var(--sp-6);
    flex-direction: column;
    gap: var(--sp-2);
  }

  .mobile-menu.is-open {
    display: flex;
  }

  .mobile-nav-link {
    font-size: var(--text-base);
    font-weight: 600;
    color: rgba(255, 255, 255, 0.85);
    padding: var(--sp-3) 0;
    border-bottom: 1px solid rgba(255,255,255,0.08);
    transition: color var(--t-fast);
  }

  .mobile-nav-link:hover,
  .mobile-nav-link:focus-visible {
    color: var(--c-white);
  }

  .mobile-lang {
    display: flex;
    gap: var(--sp-2);
    padding-top: var(--sp-4);
  }

  .mobile-wa-btn {
    margin-top: var(--sp-4);
    justify-content: center;
    width: 100%;
  }

  /* Desktop breakpoint */
  @media (min-width: 1024px) {
    .header-nav {
      display: flex;
    }

    .lang-switcher {
      display: flex;
    }

    .header-wa-btn {
      display: inline-flex;
    }

    .menu-toggle {
      display: none;
    }

    .mobile-menu {
      display: none !important;
    }
  }

  @media (max-width: 640px) {
    .site-header { height: 96px; }
    .service-bar-inner { justify-content: center; height: 26px; }
    .service-bar a { display: none; }
    .header-inner { height: 70px; }
    .mobile-menu { top: 96px; }
  }
</style>
