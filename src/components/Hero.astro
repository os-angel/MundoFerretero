---
// Hero.astro
interface Props {
  t: Record<string, any>;
}
const { t } = Astro.props;
const waMsg = encodeURIComponent(t.common.whatsapp_msg);
const waUrl = `https://wa.me/${t.common.wa_number}?text=${waMsg}`;
const cementSlides = [
  { name: 'Cemento UGC Progreso', image: '/images/products/cemento-ugc.png', alt: 'Saco de Cemento UGC Progreso de 42.5 kg' },
  { name: 'Cemento Obrero', image: '/images/products/cemento-obrero.png', alt: 'Saco de Cemento Obrero de 42.5 kg' },
  { name: 'Cemento Internacional', image: '/images/products/cemento-internacional.png', alt: 'Saco de Cemento Internacional de 42.5 kg' },
];
---

<section class="hero" aria-label="Mundo Ferretero — Materiales de construcción">
  <div class="container hero-inner">

    <!-- Left: Content -->
    <div class="hero-content">
      <p class="eyebrow">{t.hero.eyebrow}</p>
      <h1 class="hero-headline">{t.hero.headline}</h1>
      <p class="hero-sub">{t.hero.subheadline}</p>

      <div class="hero-actions">
        <a href="#productos" class="btn btn--primary" id="hero-btn-products">
          {t.hero.cta_products}
        </a>
        <a
          href={waUrl}
          class="btn btn--outline-white"
          target="_blank"
          rel="noopener noreferrer"
          id="hero-btn-whatsapp"
          aria-label="Escribir por WhatsApp a Mundo Ferretero"
        >
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.890-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          {t.hero.cta_whatsapp}
        </a>
      </div>

      <p class="hero-shipping-note">
        <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
        {t.hero.shipping_note}
      </p>
    </div>

    <!-- Right: Cement carousel -->
    <div class="hero-carousel" role="region" aria-roledescription="carrusel" aria-label="Tipos de cemento disponibles">
      <div class="carousel-track">
        {cementSlides.map((slide, index) => (
          <div class={`carousel-slide ${index === 0 ? 'is-active' : ''}`} aria-hidden={index === 0 ? 'false' : 'true'}>
            <img
              src={slide.image}
              alt={slide.alt}
              class="hero-image"
              width="600"
              height="600"
              fetchpriority={index === 0 ? 'high' : undefined}
              loading={index === 0 ? 'eager' : 'lazy'}
              decoding="async"
            />
            <span class="carousel-caption">{slide.name}</span>
          </div>
        ))}
      </div>
      <div class="carousel-controls">
        <button class="carousel-arrow" type="button" data-carousel-prev aria-label="Ver cemento anterior">‹</button>
        <div class="carousel-dots" role="tablist" aria-label="Seleccionar tipo de cemento">
          {cementSlides.map((slide, index) => (
            <button class={`carousel-dot ${index === 0 ? 'is-active' : ''}`} type="button" role="tab" aria-label={`Ver ${slide.name}`} aria-selected={index === 0 ? 'true' : 'false'} data-carousel-dot={index}></button>
          ))}
        </div>
        <button class="carousel-arrow" type="button" data-carousel-next aria-label="Ver siguiente cemento">›</button>
      </div>
    </div>

  </div>
</section>

<script>
  const carousel = document.querySelector('.hero-carousel');
  const slides = Array.from(carousel?.querySelectorAll('.carousel-slide') ?? []);
  const dots = Array.from(carousel?.querySelectorAll<HTMLButtonElement>('[data-carousel-dot]') ?? []);
  let current = 0;
  let timer: number | undefined;

  function showSlide(next: number) {
    current = (next + slides.length) % slides.length;
    slides.forEach((slide, index) => {
      const active = index === current;
      slide.classList.toggle('is-active', active);
      slide.setAttribute('aria-hidden', String(!active));
      dots[index]?.classList.toggle('is-active', active);
      dots[index]?.setAttribute('aria-selected', String(active));
    });
  }

  function startRotation() {
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      timer = window.setInterval(() => showSlide(current + 1), 4500);
    }
  }

  function resetRotation() {
    if (timer) window.clearInterval(timer);
    startRotation();
  }

  carousel?.querySelector('[data-carousel-prev]')?.addEventListener('click', () => { showSlide(current - 1); resetRotation(); });
  carousel?.querySelector('[data-carousel-next]')?.addEventListener('click', () => { showSlide(current + 1); resetRotation(); });
  dots.forEach((dot, index) => dot.addEventListener('click', () => { showSlide(index); resetRotation(); }));
  carousel?.addEventListener('mouseenter', () => { if (timer) window.clearInterval(timer); });
  carousel?.addEventListener('mouseleave', startRotation);
  startRotation();
</script>

<style>
  .hero {
    background: var(--c-blue);
    color: var(--c-white);
    padding-block: var(--sp-12);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-10);
    align-items: center;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }

  .hero-headline {
    font-size: var(--text-3xl);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--c-white);
    max-width: 22ch;
  }

  .hero-sub {
    font-size: var(--text-md);
    color: rgba(255, 255, 255, 0.72);
    line-height: 1.65;
    max-width: 46ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    margin-top: var(--sp-2);
  }

  .hero-shipping-note {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.55);
    margin-top: var(--sp-2);
  }

  /* Cement carousel */
  .hero-carousel {
    border-radius: var(--radius-md);
    overflow: hidden;
    aspect-ratio: 1 / 1;
    max-width: 500px;
    width: 100%;
    margin-inline: auto;
    border: 1px solid rgba(255,255,255,.22);
    box-shadow: none;
    background: #f7f7f5;
  }

  .carousel-track { position: relative; width: 100%; height: 100%; }
  .carousel-slide { position: absolute; inset: 0; display: grid; place-items: center; opacity: 0; transform: translateX(8%); transition: opacity 400ms ease, transform 400ms ease; pointer-events: none; }
  .carousel-slide.is-active { opacity: 1; transform: translateX(0); pointer-events: auto; }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    background-color: #f7f7f5;
    transition: transform var(--t-slow);
  }

  .carousel-slide:hover .hero-image {
    transform: scale(1.02);
  }

  .carousel-caption { position: absolute; left: .75rem; bottom: .75rem; padding: .3rem .55rem; background: var(--c-blue); color: var(--c-white); font-size: .75rem; font-weight: 700; }
  .carousel-controls { position: absolute; z-index: 2; left: .85rem; right: .85rem; bottom: .8rem; display: flex; align-items: center; justify-content: space-between; }
  .carousel-arrow, .carousel-dot { border: 0; cursor: pointer; }
  .carousel-arrow { width: 30px; height: 30px; border-radius: var(--radius-sm); background: var(--c-white); color: var(--c-blue); font-size: 1.5rem; line-height: 1; }
  .carousel-dots { display: flex; gap: .4rem; }
  .carousel-dot { width: 8px; height: 8px; padding: 0; border-radius: 50%; background: rgba(255,255,255,.65); }
  .carousel-dot.is-active { background: var(--c-orange); }

  /* Desktop */
  @media (min-width: 1024px) {
    .hero {
      padding-block: var(--sp-16);
    }

    .hero-inner {
      grid-template-columns: 1fr 1fr;
      gap: var(--sp-16);
    }

    .hero-headline {
      font-size: var(--text-4xl);
    }

    .hero-carousel {
      max-width: 100%;
      margin-inline: 0;
    }
  }
</style>
