---
// LocationContact.astro
interface Props {
  t: Record<string, any>;
}
const { t } = Astro.props;
const phoneUrl = `tel:${t.common.phone_number.replace(/[\s\-]/g, '')}`;
const waMsg = encodeURIComponent(t.common.whatsapp_msg);
const waUrl = `https://wa.me/${t.common.wa_number}?text=${waMsg}`;
// Google Maps embed for Cantón Panaj, Santiago Atitlán
// Coordinates: 14.6253635, -91.2333991
const mapSrc = "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d244.28867827843527!2d-91.2335995!3d14.6253949!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x858ecbcc07692dc7%3A0x6de0e976ae90d64a!2sVista%20del%20Volc%C3%A1n!5e0!3m2!1ses!2sgt!4v1699000000000!5m2!1ses!2sgt";
---

<section class="location section" id="contacto" aria-labelledby="location-title">
  <div class="container">

    <div class="location-inner">

      <!-- Info column -->
      <div class="location-info">
        <h2 class="section-title" id="location-title">{t.location.title}</h2>

        <dl class="location-details">
          <div class="detail-item">
            <dt class="detail-label">
              <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
              {t.location.address_label}
            </dt>
            <dd class="detail-value">{t.location.address}</dd>
          </div>

          <div class="detail-item">
            <dt class="detail-label">
              <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 10.8 19.79 19.79 0 01.12 2.2 2 2 0 012.11 0h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.91 7.09a16 16 0 006 6l.56-.56a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 14.92z"/>
              </svg>
              {t.location.phone_label}
            </dt>
            <dd class="detail-value">
              <a href={phoneUrl} class="detail-link" aria-label={`Llamar al ${t.location.phone}`}>{t.location.phone}</a>
              {' · '}
              <a href={waUrl} class="detail-link detail-link--wa" target="_blank" rel="noopener noreferrer" aria-label="Contactar por WhatsApp">WhatsApp</a>
            </dd>
          </div>

          <div class="detail-item">
            <dt class="detail-label">
              <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12 6 12 12 16 14"/>
              </svg>
              {t.location.hours_label}
            </dt>
            <dd class="detail-value">{t.location.hours}</dd>
          </div>
        </dl>

        <div class="location-actions">
          <a
            href={waUrl}
            class="btn btn--primary"
            target="_blank"
            rel="noopener noreferrer"
            id="location-whatsapp-btn"
          >
            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.890-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            {t.cta_section.cta_whatsapp}
          </a>
          <a href={phoneUrl} class="btn btn--outline" id="location-call-btn">
            {t.cta_section.cta_call}: {t.location.phone}
          </a>
        </div>
      </div>

      <!-- Map column -->
      <div class="location-map">
        <iframe
          src={mapSrc}
          title="Ubicación de Mundo Ferretero en Santiago Atitlán, Sololá, Guatemala"
          width="600"
          height="450"
          style="border:0;"
          allowfullscreen
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="map-iframe"
        ></iframe>
      </div>

    </div>
  </div>
</section>

<style>
  .location {
    background-color: var(--c-bg);
  }

  .location-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-10);
  }

  /* Info */
  .location-info {
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
  }

  .location-details {
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
    margin-top: var(--sp-2);
  }

  .detail-item {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
  }

  .detail-label {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-text-light);
  }

  .detail-label svg {
    color: var(--c-orange);
    flex-shrink: 0;
  }

  .detail-value {
    font-size: var(--text-base);
    color: var(--c-text);
    font-weight: 600;
    padding-left: calc(16px + var(--sp-2));
  }

  .detail-link {
    color: var(--c-blue);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color var(--t-fast);
  }

  .detail-link:hover,
  .detail-link:focus-visible {
    color: var(--c-orange);
  }

  .detail-link--wa {
    color: #128C7E;
  }

  .location-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
  }

  /* Map */
  .location-map {
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--c-border);
    aspect-ratio: 4 / 3;
    min-height: 280px;
  }

  .map-iframe {
    width: 100%;
    height: 100%;
    display: block;
  }

  @media (min-width: 1024px) {
    .location-inner {
      grid-template-columns: 1fr 1fr;
      gap: var(--sp-16);
      align-items: start;
    }

    .location-map {
      aspect-ratio: auto;
      height: 440px;
    }
  }
</style>
