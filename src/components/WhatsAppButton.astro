---
// WhatsAppButton.astro — Floating WhatsApp button
interface Props {
  waNumber: string;
  waMsg: string;
}
const { waNumber, waMsg } = Astro.props;
const encodedMsg = encodeURIComponent(waMsg);
const waUrl = `https://wa.me/${waNumber}?text=${encodedMsg}`;
---

<a
  href={waUrl}
  class="wa-float"
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Contactar a Mundo Ferretero por WhatsApp"
  id="floating-whatsapp-btn"
>
  <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.890-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
  </svg>
  <span class="wa-tooltip">WhatsApp</span>
</a>

<style>
  .wa-float {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    background-color: #25D366;
    color: var(--c-white);
    border-radius: 50%;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.18);
    transition:
      background-color var(--t-fast),
      transform var(--t-fast),
      box-shadow var(--t-fast);
    -webkit-tap-highlight-color: transparent;
    animation: wa-attention 3.4s ease-in-out 2s infinite;
  }

  .wa-float::after {
    content: '';
    position: absolute;
    inset: -5px;
    border: 2px solid rgba(37, 211, 102, .55);
    border-radius: inherit;
    animation: wa-ring 3.4s ease-out 2s infinite;
    pointer-events: none;
  }

  .wa-float:hover,
  .wa-float:focus-visible {
    background-color: #1DB954;
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.22);
  }

  .wa-float:active {
    transform: translateY(0);
  }

  @keyframes wa-attention {
    0%, 8%, 100% { transform: translateY(0); }
    3% { transform: translateY(-4px); }
    6% { transform: translateY(-2px); }
  }

  @keyframes wa-ring {
    0%, 8% { opacity: 0; transform: scale(.82); }
    4% { opacity: .8; }
    14%, 100% { opacity: 0; transform: scale(1.28); }
  }

  /* Tooltip */
  .wa-tooltip {
    position: absolute;
    right: calc(100% + 10px);
    background-color: var(--c-text);
    color: var(--c-white);
    font-size: var(--text-xs);
    font-weight: 600;
    padding: 0.3rem 0.6rem;
    border-radius: var(--radius-sm);
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--t-base);
  }

  .wa-float:hover .wa-tooltip,
  .wa-float:focus-visible .wa-tooltip {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .wa-float, .wa-float::after { animation: none; }
  }
</style>
