---
// BaseLayout.astro — HTML base, SEO meta, Schema.org
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  ogImage?: string;
  products?: any[];
}

const {
  title = 'Mundo Ferretero | Ferretería en Santiago Atitlán',
  description = 'Materiales para construcción en Santiago Atitlán. Cemento, block, tubería, sanitarios, poliducto y más. Consulta disponibilidad y servicio de envío.',
  lang = 'es',
  ogImage = '/logo.png',
  products = [],
} = Astro.props;

const siteUrl = 'https://mundoferreterogt.com';
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const ogImageAbsolute = new URL(ogImage, siteUrl).href;
const spanishUrl = new URL('/', siteUrl).href;
const englishUrl = new URL('/en/', siteUrl).href;

const businessSchema = {
  "@context": "https://schema.org",
  "@type": "HardwareStore",
  "name": "Mundo Ferretero",
  "description": "Ferretería y materiales de construcción en Santiago Atitlán, Sololá, Guatemala.",
  "url": siteUrl,
  "logo": new URL('/logo.png', siteUrl).href,
  "telephone": "+50239216866",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Cantón Panaj",
    "addressLocality": "Santiago Atitlán",
    "addressRegion": "Sololá",
    "addressCountry": "GT"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 14.6253635,
    "longitude": -91.2333991
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"],
      "opens": "08:00",
      "closes": "18:00"
    }
  ]
};

const productSchemas = products
  .filter((product) => product.price !== null && product.price !== undefined)
  .map((product) => ({
    "@type": "Product",
    "name": product.name?.[lang] ?? product.name?.es,
    "description": product.description?.[lang] ?? product.description?.es,
    "image": product.image ? new URL(product.image, siteUrl).href : undefined,
    "offers": {
      "@type": "Offer",
      "url": canonical,
      "priceCurrency": "GTQ",
      "price": String(product.price)
    }
  }));

const schemaLD = productSchemas.length
  ? { "@context": "https://schema.org", "@graph": [businessSchema, ...productSchemas] }
  : businessSchema;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Primary SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />
    <link rel="alternate" hreflang="es-GT" href={spanishUrl} />
    <link rel="alternate" hreflang="en" href={englishUrl} />
    <link rel="alternate" hreflang="x-default" href={spanishUrl} />

    <!-- OpenGraph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Mundo Ferretero" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbsolute} />
    <meta property="og:locale" content={lang === 'es' ? 'es_GT' : lang === 'en' ? 'en_US' : 'es_GT'} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbsolute} />

    <!-- Local SEO keywords -->
    <meta name="keywords" content="ferretería Santiago Atitlán, materiales construcción Santiago Atitlán, cemento Santiago Atitlán, block Santiago Atitlán, tubería Santiago Atitlán, Mundo Ferretero" />
    <meta name="geo.region" content="GT-SO" />
    <meta name="geo.placename" content="Santiago Atitlán, Sololá, Guatemala" />
    <meta name="geo.position" content="14.6253635;-91.2333991" />
    <meta name="ICBM" content="14.6253635, -91.2333991" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <!-- Preconnect for fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaLD)} />

    <!-- Sitemap reference -->
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <slot />
    <script>
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const revealItems = document.querySelectorAll('.hero-content, .hero-carousel, .categories-header, .category-item, .shipping-inner, .cta-inner, .location-info, .location-map, .footer-brand, .footer-col');

      if (!reduceMotion && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.12 });

        revealItems.forEach((item, index) => {
          item.classList.add('reveal');
          item.style.setProperty('--reveal-delay', `${Math.min(index % 4, 3) * 55}ms`);
          observer.observe(item);
        });
      }
    </script>
  </body>
</html>
