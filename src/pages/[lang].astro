---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Categories from '../components/Categories.astro';
import ShippingBlock from '../components/ShippingBlock.astro';
import CtaBlock from '../components/CtaBlock.astro';
import LocationContact from '../components/LocationContact.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import enStrings from '../data/i18n/en.json';
import tzuStrings from '../data/i18n/tzu.json';
import productsData from '../data/products.json';

export function getStaticPaths() {
  return ['en', 'tzu'].map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang === 'tzu' ? 'tzu' : 'en';
const t = lang === 'tzu' ? tzuStrings : enStrings;
const categories = productsData.categories;
---

<BaseLayout
  title={lang === 'en' ? 'Mundo Ferretero | Hardware Store in Santiago Atitlán' : 'Mundo Ferretero | Ferretería en Santiago Atitlán'}
  description="Construction materials in Santiago Atitlán. Ask about availability and delivery service."
  lang={lang}
>
  <Header t={t} lang={lang} />
  <main id="main-content">
    <Hero t={t} />
    <Categories t={t} lang={lang} categories={categories} />
    <ShippingBlock t={t} />
    <CtaBlock t={t} />
    <LocationContact t={t} />
  </main>
  <Footer t={t} />
  <WhatsAppButton waNumber={t.common.wa_number} waMsg={t.common.whatsapp_msg} />
</BaseLayout>
